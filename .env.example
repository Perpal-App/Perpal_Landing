# Production values only. Keep localhost configuration in the untracked .env.local.
MONGODB_URI=mongodb+srv://username:password@cluster.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=perpal
# Must be one exact public HTTPS origin; production rejects localhost and loopback.
WAITLIST_ALLOWED_ORIGIN=https://perpal.app
# This header must be overwritten by your trusted reverse proxy, never forwarded from the client.
WAITLIST_IP_HEADER=x-real-ip
# Generate with: openssl rand -base64 48
WAITLIST_HMAC_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
# Generate with: openssl rand -base64 32
WAITLIST_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
